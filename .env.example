# ─── Backend (copy to backend/.env) ───
PORT=4100
NODE_ENV=development
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=12h
# Encryption at rest of medical fields (AES-256-GCM): 32 random bytes in base64, e.g. `openssl rand -base64 32`.
# Keep a safe copy outside the server: without it, encrypted data cannot be read back.
DATA_ENCRYPTION_KEY=
# Two-step login for doctors and Super Admin (true in production; demo accounts are always exempt)
MFA_REQUIRED=true
CORS_ORIGIN=http://localhost:5174

# MySQL
DATABASE_URL="mysql://root:password@localhost:3306/cabinet_pro"
SHADOW_DATABASE_URL="mysql://root:password@localhost:3306/cabinet_pro_shadow"

# Seed
SUPER_ADMIN_EMAIL=superadmin@cabinetpro.ma
SUPER_ADMIN_PASSWORD=Admin123!
# false = no demo cabinet with fictitious patients
SEED_DEMO=true

# Free trial for self-service sign-up
TRIAL_DAYS=3
TRIAL_PLAN_CODE=TRIAL

# Patient files (X-rays, PDFs) — max size per file, in MB
ATTACHMENT_MAX_MB=20

# Reminders (background job, runs every minute)
APP_TIMEZONE=Africa/Casablanca
DEFAULT_COUNTRY_CODE=212
REMINDER_JOB_INTERVAL_MS=60000
REMINDERS_DISABLED=false

# SMS via Infobip (empty = messages are logged, not sent)
INFOBIP_BASE_URL=
INFOBIP_API_KEY=
INFOBIP_SMS_SENDER=CabinetPro

# WhatsApp via Meta WhatsApp Cloud API (empty = logged, not sent)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v20.0
WHATSAPP_TEMPLATE_LANG=fr
# Approved template names. Body placeholders:
#   appointment: {{1}} patient first name, {{2}} cabinet, {{3}} date and time, {{4}} practitioner
#   plan expiry: {{1}} cabinet, {{2}} end date, {{3}} subject
#   owner message: {{1}} sender name, {{2}} message, {{3}} sender phone
WHATSAPP_TEMPLATE_APPOINTMENT=
WHATSAPP_TEMPLATE_PLAN_EXPIRY=
WHATSAPP_TEMPLATE_OWNER_MESSAGE=
#   payment reminder: {{1}} first name, {{2}} cabinet, {{3}} amount, {{4}} invoice number
#   document link: {{1}} first name, {{2}} cabinet, {{3}} link
WHATSAPP_TEMPLATE_PAYMENT=
WHATSAPP_TEMPLATE_DOCUMENT=

# Daily database backup (docker-compose "backup" service, files in ./backups)
BACKUP_KEEP_DAYS=14
BACKUP_HOUR_UTC=1

# Online subscription payment by card: CMI (Centre Monétique Interbancaire), hosted payment page.
# Empty = no online payment (the owner is asked to pay by transfer). Test gateway by default.
CMI_CLIENT_ID=
CMI_STORE_KEY=
CMI_GATEWAY_URL=https://testpayment.cmi.co.ma/fim/est3Dgate
# Public address of the API, given to the CMI for its callback (default: FRONTEND_URL + /api)
API_PUBLIC_URL=
FRONTEND_URL=http://localhost:5174

# ─── Frontend (build time) ───
VITE_API_URL=/api
